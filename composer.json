{
  "name": "blazemeter/pwe",
  "description": "Lightweight PHP framework (Pluggable Web Engine), BlazeMeter fork of undera/pwe used by gettaurus.org",
  "minimum-stability": "dev",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Blazemeter/pwe",
  "authors": [
    {
      "name": "Andrey Pokhilko",
      "email": "apc4@ya.ru",
      "role": "Original author"
    },
    {
      "name": "BlazeMeter",
      "homepage": "https://www.blazemeter.com",
      "role": "Maintainer"
    }
  ],
  "support": {
    "source": "https://github.com/Blazemeter/pwe",
    "issues": "https://github.com/Blazemeter/pwe/issues"
  },
  "require-dev": {
    "phpunit/phpunit": "~4"
  },
  "require": {
    "php": ">=7.1",
    "smarty/smarty": "^5.8",
    "jelix/wikirenderer": "3.1.11",
    "ext-xml": "*",
    "ext-json": "*",
    "ext-posix": "*"
  },
  "suggest": {
    "easybook/geshi": "Syntax highlighting of code blocks in SimpleWiki (GPL-2.0), without it code blocks are rendered unhighlighted"
  },
  "autoload": {
    "psr-0": {
      "PWE\\": "."
    }
  }
}
